# Configuration for custom Coder build
# These variables can be overridden when running docker-compose

# Version to build. Keep this aligned with ./scripts/version.sh.
VERSION=2.29.10

# Architecture to build for (amd64, arm64, armv7)
ARCH=amd64

# Image name and tag
IMAGE_NAME=coder-custom
IMAGE_TAG=2.29.10

# Coder configuration
CODER_ACCESS_URL=http://localhost:3000
CODER_PG_CONNECTION_URL=postgresql://coder:password@postgres:5432/coder?sslmode=disable

# PostgreSQL configuration
POSTGRES_DB=coder
POSTGRES_USER=coder
POSTGRES_PASSWORD=password
